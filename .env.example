NODE_ENV=development
PORT=3200
PUBLIC_URL=http://localhost:3100
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=style_rinero
DB_USER=style_user
DB_PASSWORD=replace-me
# Configure only after provider onboarding. Never put live secrets in the frontend.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SESSION_SECRET=replace-with-a-long-random-secret
# Native passkeys remain disabled until app signing and domain associations are configured.
WEBAUTHN_NATIVE_ORIGINS=
STYLE_IOS_BUNDLE_ID=
STYLE_APPLE_TEAM_ID=
STYLE_ANDROID_PACKAGE=
STYLE_ANDROID_SHA256_FINGERPRINTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
STYLE_EMAIL_FROM=Style by Rinero <no-reply@style.rinero.app>
