# Same-origin API proxy target. Use the private API address on the server.
STYLE_API_BASE_URL=http://127.0.0.1:3200
# Public browser key. Add before building, and restrict it to approved referrers.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Public app/domain association identifiers used by the native passkey setup.
STYLE_APPLE_TEAM_ID=
STYLE_IOS_BUNDLE_ID=
STYLE_ANDROID_PACKAGE=
STYLE_ANDROID_SHA256_FINGERPRINTS=
